# ---------------------------------------------------------------------------
# APC Lagos — environment configuration
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Only NEXT_PUBLIC_* values are exposed to the browser — keep secrets unprefixed.
# ---------------------------------------------------------------------------

# Canonical origin of the deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.apclagos.org

# ---- Contact form -------------------------------------------------------
# Shared secret used to sign the contact form's anti-spam token (server only).
CONTACT_FORM_SECRET=change-me-to-a-long-random-string

# Where contact submissions are delivered. Wire these up in
# src/lib/server/contact.ts (deliverContactMessage) when an email provider is chosen.
CONTACT_INBOX_EMAIL=info@apclagos.org
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---- Content admin (Keystatic) -----------------------------------------
# The editor lives at /keystatic (and /admin redirects there).
#
# In development it runs in "local" mode with NO authentication and writes
# straight to the working tree — convenient locally, and the reason the mode is
# chosen by NODE_ENV rather than by a variable you could set by accident.
#
# In production it runs in "github" mode: editors sign in with GitHub and
# authorisation is the repository's collaborator list. To enable it, create a
# GitHub App from the editor's own setup screen and paste the values it gives
# you here. Nothing works until all four are set.
NEXT_PUBLIC_KEYSTATIC_GITHUB_OWNER=
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# A long random string used to sign the editor's session cookie.
KEYSTATIC_SECRET=

# ---- Data source --------------------------------------------------------
# Leave empty to read from the typed files in src/data (the default).
# Point at a Node/Express API base URL to switch the data layer over.
# CONTENT_API_URL=
# CONTENT_API_TOKEN=

# ---- Analytics / verification (optional) --------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GOOGLE_SITE_VERIFICATION=
