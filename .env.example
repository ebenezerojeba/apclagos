# ---------------------------------------------------------------------------
# APC Lagos — environment configuration
#
# Copy to `.env.local` and fill THAT file in — not this one.
#
#   cp .env.example .env.local
#
# This file is TRACKED BY GIT and must never hold a real value. Next.js does
# not read it: it loads .env.local, .env.development.local,
# .env.production.local, .env.development, .env.production and .env only.
# Only NEXT_PUBLIC_* values reach the browser — keep every secret unprefixed.
# ---------------------------------------------------------------------------

# ---- Database (REQUIRED) --------------------------------------------------
# MongoDB Atlas connection string. Server-only.
# Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/apclagos?retryWrites=true&w=majority
# Percent-encode any reserved character in the password (@ : / ? # [ ] %).
MONGODB_URI=

# Database inside the cluster. Optional — defaults to `apclagos`. Set it only
# if you want a different name, or a separate database per environment.
# Without this (and without a database path in the URI) Mongoose would write
# to a database called `test`.
MONGODB_DB_NAME=

# ---- Admin authentication (REQUIRED) ---------------------------------------
# Signs the admin session cookie. Server-only. At least 32 characters.
# Generate with: openssl rand -base64 32
# Rotating this signs everyone out, which is the intended way to revoke access.
AUTH_SECRET=

# ---- Media (REQUIRED for image upload) ------------------------------------
# The cloud name appears in every delivery URL, so it is public by design.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# These two are secret. The API secret NEVER reaches the browser: uploads are
# signed on the server and posted from the browser straight to Cloudinary.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Site (REQUIRED in production) ----------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph tags
# and the sitemap. A wrong value here is an SEO fault, not a crash.
NEXT_PUBLIC_SITE_URL=

# ---- Contact form (OPTIONAL) ----------------------------------------------
# Signs the form's anti-spam token. Without it the form refuses submissions.
CONTACT_FORM_SECRET=
# Where enquiries are delivered. Wire the transport up in
# src/lib/server/contact.ts (deliverContactMessage).
CONTACT_INBOX_EMAIL=

# ---- Search Console (OPTIONAL) --------------------------------------------
GOOGLE_SITE_VERIFICATION=

# ---- Local development only ------------------------------------------------
# Leave blank. Set it ONLY if MongoDB fails with `querySrv EBADRESP` or
# `ETIMEOUT`, which means your router or hotspot mangles the SRV lookup that
# every mongodb+srv:// URI depends on. Ignored in production.
#   DEV_DNS_SERVERS=8.8.8.8,8.8.4.4
DEV_DNS_SERVERS=
